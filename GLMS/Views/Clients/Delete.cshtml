@using GLMS.Shared.DTOs
@model ClientDto

<h2>Delete Client</h2>

<h4>Are you sure you want to delete this client?</h4>

<p><strong>Name:</strong> @Model.Name</p>
<p><strong>Contact:</strong> @Model.ContactDetails</p>
<p><strong>Region:</strong> @Model.Region</p>

<form method="post" action="/Clients/DeleteConfirmed">
    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a href="/Clients/Index" class="btn btn-secondary">Cancel</a>
</form>