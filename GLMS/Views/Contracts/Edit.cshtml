@model ContractDto

<h2>Edit Contract</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <!-- CLIENT -->
    <label>Client</label>
    <select asp-for="ClientId" class="form-control">
        @foreach (var c in ViewBag.Clients)
        {
            <option value="@c.Id" selected="@(c.Id == Model.ClientId)">
                @c.Name
            </option>
        }
    </select>

    <!-- STATUS -->
    <label>Status</label>
    <select asp-for="Status" class="form-control">
        @foreach (var s in ViewBag.StatusList)
        {
            <option value="@s" selected="@(s == Model.Status)">
                @s
            </option>
        }
    </select>

    <!-- SERVICE LEVEL -->
    <label>Service Level</label>
    <select asp-for="ServiceLevel" class="form-control">
        @foreach (var s in ViewBag.ServiceLevels)
        {
            <option value="@s" selected="@(s == Model.ServiceLevel)">
                @s
            </option>
        }
    </select>

    <!-- DATES -->
    <label>Start Date</label>
    <input asp-for="StartDate" type="date" class="form-control" />

    <label>End Date</label>
    <input asp-for="EndDate" type="date" class="form-control" />

    <br />

    <button type="submit" class="btn btn-success">Save</button>
</form>